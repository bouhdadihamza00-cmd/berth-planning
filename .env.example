# Supplied Python client. Cookies are loaded only by the backend from an ignored file.
# MARINETRAFFIC_CLIENT_COOKIES_FILE=/absolute/private/path/cookies.json
MARINETRAFFIC_CLIENT_ZOOM=12
MARINETRAFFIC_CLIENT_SPEED_UNIT=tenths_knots
MARINETRAFFIC_CLIENT_ELAPSED_UNIT=minutes
# Local server defaults:
# HOST=127.0.0.1
# PORT=8000
# PORTOPS_DB=/absolute/path/portops.db

# Optional planning AI. Disabled by default; select exactly one provider.
PORTOPS_AI_PROVIDER=disabled
# PORTOPS_AI_PROVIDER=client_hosted
# PORTOPS_AI_BASE_URL=http://127.0.0.1:8001/v1
# PORTOPS_AI_MODEL=your-deployed-model-id
# PORTOPS_AI_API_KEY=
# PORTOPS_AI_VISION=false

# Native Ollama can reject oversized prompts instead of silently truncating them.
# PORTOPS_AI_PROTOCOL=ollama
# PORTOPS_AI_BASE_URL=http://127.0.0.1:11434
# PORTOPS_AI_CONTEXT_TOKENS=16384
# PORTOPS_AI_MAX_OUTPUT_TOKENS=4096
# PORTOPS_AI_MAX_INPUT_CHARS=48000
# PORTOPS_AI_TIMEOUT_SECONDS=300

# Free-only cloud option. Never uses Codex/OPENAI_API_KEY or paid model fallback.
# PORTOPS_AI_PROVIDER=openrouter_free
# PORTOPS_AI_BASE_URL=https://openrouter.ai/api/v1
# PORTOPS_AI_PROTOCOL=openai
# PORTOPS_AI_MODEL=openrouter/free
# OPENROUTER_API_KEY=
# Or use a private, ignored JSON file (mode 600):
# PORTOPS_AI_CREDENTIALS_FILE=/absolute/path/free-ai-providers.json

# Free MET Norway weather API; identify your production domain/contact. No API key.
# WEATHER_USER_AGENT=Portside/1.0 your-deployment-domain.example

# Copernicus Marine: private authorized MyOcean/CDSE session, never browser assets.
# COPERNICUS_SESSION_FILE=/absolute/private/path/copernicus-session.json
